// Modelo de datos: responsabilidad de T-01 parte de datos (Santiago Torralba).
// Los modelos y migraciones se agregan aquí con `pnpm --filter @red/api prisma:migrate`.
// Cada bloque indica el módulo dueño (Documento Tecnológico 2.3): ningún módulo lee las tablas de otro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── identity (EP-01) ────────────────────────────────────────────────────────

enum AccountStatus {
  PENDING_CONFIRMATION // HU-001 CA1: no puede postularse ni publicar
  ACTIVE
  SUSPENDED // HU-012: bloqueo por moderación
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(120)
  email            String        @unique @db.VarChar(254) // siempre en minúsculas
  phone            String        @db.VarChar(20) // uso interno, nunca público (RF-02-07)
  passwordHash     String        @map("password_hash")
  status           AccountStatus @default(PENDING_CONFIRMATION)
  role             UserRole      @default(USER)
  ageConfirmedAt   DateTime      @map("age_confirmed_at") // HU-017: declaración de mayoría de edad
  emailConfirmedAt DateTime?     @map("email_confirmed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  consents           Consent[]
  confirmationTokens EmailConfirmationToken[]
  refreshTokens      RefreshToken[]
  workerProfile      WorkerProfile?
  publisherProfile   PublisherProfile?

  @@map("users")
}

// Enlace de confirmación de correo con vigencia de 24 h (RF-01-04). Solo se guarda el hash del token.
model EmailConfirmationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_confirmation_tokens")
}

// Token de renovación rotativo (Documento Tecnológico 6.3). Reusar uno ya rotado revoca toda su familia.
// HU-021 (Juan José Baloco) define la lógica; el bloqueo tras 5 intentos queda pendiente de PO-05.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  rotatedAt  DateTime? @map("rotated_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?   @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum LegalDocumentType {
  TERMS
  PRIVACY_POLICY
  DATA_TREATMENT
}

// Textos versionados de términos, privacidad y autorización de datos (HU-017).
// El vigente de cada tipo es el de mayor effectiveFrom que ya empezó.
model LegalDocument {
  id            String            @id @default(uuid()) @db.Uuid
  type          LegalDocumentType
  version       String            @db.VarChar(20)
  url           String            @db.VarChar(500)
  effectiveFrom DateTime          @map("effective_from")
  createdAt     DateTime          @default(now()) @map("created_at")

  consents Consent[]

  @@unique([type, version])
  @@map("legal_documents")
}

// Prueba del consentimiento: fecha, hora, IP y versión aceptada (RF-01-07, Ley 1581 de 2012).
model Consent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  acceptedAt      DateTime @default(now()) @map("accepted_at")
  ip              String   @db.VarChar(45)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@map("consents")
}

// ─── catálogos (T-03, datos semilla de Santiago López) ───────────────────────

model Zone {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100) // zona o barrio de Cali (RF-02-08)
  isActive Boolean @default(true) @map("is_active")

  workerProfiles WorkerProfile[]

  @@map("zones")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(300)
  isActive    Boolean @default(true) @map("is_active") // HU-037: el administrador las activa o desactiva

  workerProfiles WorkerProfile[] @relation("worker_profile_categories")

  @@map("categories")
}

// ─── profiles (EP-02) ────────────────────────────────────────────────────────

enum WorkerAvailability {
  AVAILABLE // HU-002 CA1: estado al crear el perfil
  UNAVAILABLE
}

model WorkerProfile {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @unique @map("user_id") @db.Uuid
  displayName  String             @map("display_name") @db.VarChar(120)
  photoUrl     String             @map("photo_url") @db.VarChar(500)
  skills       String[]
  experience   String?            @db.VarChar(2000)
  zoneId       Int                @map("zone_id")
  availability WorkerAvailability @default(AVAILABLE)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone       Zone       @relation(fields: [zoneId], references: [id])
  categories Category[] @relation("worker_profile_categories") // HU-002: categorías de interés

  @@map("worker_profiles")
}

enum PublisherKind {
  PERSON
  COMPANY
}

// Perfil de publicador persona natural o empresa (HU-008). Los campos de empresa son nulos para PERSON.
model PublisherProfile {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @unique @map("user_id") @db.Uuid
  kind          PublisherKind
  displayName   String        @map("display_name") @db.VarChar(160) // nombre o razón social
  photoUrl      String        @map("photo_url") @db.VarChar(500) // foto o logo
  description   String        @db.VarChar(1000)
  nit           String?       @unique @db.VarChar(10) // solo dígitos, sin dígito de verificación
  nitCheckDigit String?       @map("nit_check_digit") @db.Char(1)
  contactName   String?       @map("contact_name") @db.VarChar(120)
  sector        String?       @db.VarChar(100)
  isVerified    Boolean       @default(false) @map("is_verified") // HU-020, Fase 4
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("publisher_profiles")
}
