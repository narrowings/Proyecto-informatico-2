# Copiar a /opt/red-qa/qa.env en el servidor de QA (fuera del repo) y llenar. Nunca subir el archivo real.
# Usa solo letras y números en las claves para no romper DATABASE_URL.
POSTGRES_PASSWORD=cambia-esta-clave
MAILPIT_UI_AUTH=qa:cambia-esta-clave

# Firma de las sesiones de la API (mínimo 32 caracteres). Genérala con: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-por-una-de-minimo-32-caracteres

# URL pública del frontend; la API la usa para los enlaces de confirmación de correo.
WEB_URL=https://qa.example.com
NEXT_PUBLIC_API_URL=https://qa-api.example.com

# Correo (T-04). Vacío → la API usa el Mailpit de QA (sin credenciales).
# SMTP_SECURE depende del puerto:
#   465  → SMTP_SECURE=true  (TLS desde el inicio)
#   587  → SMTP_SECURE=false (empieza en claro y sube a TLS con STARTTLS; con usuario se exige)
#   1025 → SMTP_SECURE=false (Mailpit, sin TLS ni usuario)
# Ejemplos: Brevo smtp-relay.brevo.com:587 (false) · Gmail smtp.gmail.com:465 (true, contraseña de aplicación).
# Las credenciales las ponen Juan José y William en el servidor; nunca en el repo.
SMTP_HOST=
# Vacío → 1025 (Mailpit). Con Brevo: 587; con Gmail: 465.
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
# Si la clave tiene $, escríbela entre comillas simples: SMTP_PASS='...'
SMTP_PASS=
# Debe ser un remitente verificado en el proveedor, p. ej. "Red de Oportunidades <correo@dominio>".
MAIL_FROM=
# Correo del equipo para apelaciones de moderación (HU-012). Si falta, se usa MAIL_FROM.
SUPPORT_EMAIL=

# Puertos en 127.0.0.1 del servidor (cámbialos si chocan con otro servicio).
WEB_PORT=3100
API_PORT=3101
MAILPIT_PORT=8125

# true: corre `prisma db seed` en cada arranque de la API (los seeds deben ser idempotentes).
RUN_SEED=true

# Despliegue: solo se despliegan commits de main con el CI en verde.
REQUIRE_CI=true
