# Copiar a /opt/red-qa/qa.env en el servidor de QA (fuera del repo) y llenar. Nunca subir el archivo real.
# Usa solo letras y números en las claves para no romper DATABASE_URL.
POSTGRES_PASSWORD=cambia-esta-clave
MAILPIT_UI_AUTH=qa:cambia-esta-clave

# Firma de las sesiones de la API (mínimo 32 caracteres). Genérala con: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-por-una-de-minimo-32-caracteres

# URL pública del frontend; la API la usa para los enlaces de confirmación de correo.
WEB_URL=https://qa.example.com

# Puertos en 127.0.0.1 del servidor (cámbialos si chocan con otro servicio).
WEB_PORT=3100
API_PORT=3101
MAILPIT_PORT=8125

# true: corre `prisma db seed` en cada arranque de la API (los seeds deben ser idempotentes).
RUN_SEED=true

# Despliegue: solo se despliegan commits de main con el CI en verde.
REQUIRE_CI=true
