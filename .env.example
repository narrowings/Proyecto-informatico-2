# Copiar a .env (raíz) y a apps/api/.env para desarrollo local
DATABASE_URL=postgresql://red:red@localhost:5432/red_oportunidades?schema=public
PORT=3001
# development: la cookie de sesión viaja sin Secure (http://localhost). Cualquier otro valor la exige por HTTPS.
NODE_ENV=development
SMTP_HOST=localhost
SMTP_PORT=1025
# Base de los enlaces que se envían por correo (confirmación de cuenta)
WEB_URL=http://localhost:3000
# Llave para firmar los tokens de acceso (HU-021). Mínimo 32 caracteres; en QA y producción usar una distinta y secreta.
JWT_SECRET=desarrollo-local-cambia-esto-por-32-o-mas-caracteres
# Proxies propios delante de la API (Ley 1581: IP real del consentimiento y rate limiting).
# QA con Cloudflare Tunnel = 1, producción con CloudFront + ALB = 2, sin proxy = 0.
TRUSTED_PROXY_HOPS=1
